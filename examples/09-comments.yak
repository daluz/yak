# Comments are carried into the rendered output, this one included. Every
# format that has somewhere to put them gets them, JSON dialects and TOML
# among them:
#
#   yak template examples/09-comments.yak
#   yak template examples/09-comments.yak -f jwcc

service:
  # A comment above an entry stays above it.
  name: "shop"      # and one written beside a value stays beside it
  replicas: 2

  ## A comment starting with "## " addresses whoever edits the template next
  ## rather than whoever reads the output, so it is left out. The space after
  ## the marker is required: "###" below is an ordinary banner.
  port: 8080

local {
  # A binding renders nothing of its own, so a comment written on one comes
  # out wherever the binding is read back.
  region = "us-east-1"
  zone = "{region}a"   # so does one written beside the binding
}

local defaults =
  # One written inside a binding's value travels with the value.
  tier: "shared"

## A note marks a comment that describes the binding rather than what it
## renders, which is how a binding says nothing at the places that read it.
local owner = "platform"

placement:
  # What the entry says itself comes first.
  region: region
  zone: zone

team: owner

### A banner is not the marker, so this one is kept.
defaults: defaults

# A binding read in two places brings its comments along to both.
copy: defaults

workers:
  # Items keep their own comments.
  - name: "queue"
  - name: "cron"   # including the ones beside them

credentials::
  # Dropped with the hidden entry it describes.
  user: "admin"

# Comments with nothing after them come out at the end of the document.
