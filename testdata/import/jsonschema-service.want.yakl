# Generated by yak schema import from jsonschema-service.json.

import std.regex

schema Service_Config =
  name: string if (v) => size(v) <= 63 and regex.match(v, r"^[a-z][a-z0-9-]*$")
  kind:? "Service"
  replicas: integer if (v) => v > 0 = 1
  owner:? string | null
  ports: [Port] if (v) => size(v) >= 1
  labels:? {(string): string}
  probe:? HttpProbe | ExecProbe
  timeout:? integer | string if (v) => (type(v) != "integer" or v >= 1) and (type(v) != "string" or regex.match(v, r"^[0-9]+s$"))
  tree:? Node
  legacy:? any
  pair:? sequence

schema Port =
  number: integer if (v) => v >= 1 and v <= 65535
  protocol: "TCP" | "UDP" = "TCP"
  (string): any

schema Probe =
  periodSeconds:? integer
  (string): any

schema HttpProbe =
  <<: Probe
  path: string
  periodSeconds: integer
  (string): any

schema ExecProbe =
  <<: Probe
  command: [string]
  (string): any

schema Node =
  value:? integer | float
  children:? [Node]
  parent:? any
  (string): any
