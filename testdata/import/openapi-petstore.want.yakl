# Generated by yak schema import from openapi-petstore.yaml.

schema Pet =
  id:? integer
  name: string
  kind: "cat" | "dog"
  tag:? string | null
  age:? integer if (v) => v > 0
  (string): any

schema Cat =
  <<: Pet
  indoor: boolean = true
  (string): any

schema Dog =
  <<: Pet
  bark:? "loud" | "quiet"
  tag: string | null

schema Nicknamed =
  <<: Pet
  (string): any

schema AnyPet = Cat | Dog

schema Owner = Name | null

schema Name = string if (v) => size(v) >= 1
