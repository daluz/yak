# Generated by yak schema import from widget.yaml.

import std.regex

schema WidgetV1 =
  apiVersion: "example.com/v1" = "example.com/v1"
  kind: "Widget" = "Widget"
  metadata:? mapping
  spec:?
    image: string if (v) => size(v) >= 1 and regex.match(v, r"^[a-z]+(:\d+)?$")
    size: integer if (v) => v >= 1 and v <= 10 = 3
    ratio:? integer | float if (v) => v > 0 and v % 0.5 == 0
    color: "red" | "blue" = "red"
    port:? integer | string if (v) => (type(v) != "integer" or v <= 65535) and (type(v) != "string" or regex.match(v, r"^\d+%?$"))
    owner:? string | null
    tags:? sequence[string] if (v) => size(unique(v)) == size(v) and size(v) <= 5
    conditions:? sequence[{
      type: string,
      status:? "True" | "False" | "Unknown",
    }]
    labels:? {(string): string} if (v) => size(v) <= 8
    limits: {
      cpu:? integer,
      memory: string = "256Mi",
    } = {cpu: 1}
    config:? mapping
    extra:?
      mode:? string
      (string): any
    template:?
      apiVersion:? string
      kind:? string
      metadata:? mapping
      (string): any
    empty:? {}
    "my-field":? boolean
    "if":? string
    "let": string = "say \"hi\" \\(x)"
  status:?
    ready:? boolean

schema WidgetV1beta1 =
  apiVersion: "example.com/v1beta1" = "example.com/v1beta1"
  kind: "Widget" = "Widget"
  metadata:? mapping
  (string): any
