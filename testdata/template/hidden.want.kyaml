---
{
  services: {
    web: {
      image: "alpine:3.20",
      port: 8080,
      label: "service web-1",
      # "::?" keeps the entry unless its value turns out null.
      replicas: 3,
      limits: {
        memory: "512Mi",
      },
    },
    worker: {
      image: "alpine:3.20",
      port: 8080,
      replicas: 3,
    },
  },
}
