## lib.* resolves from the package root, and lib.labels is a library;
## shared and base are dependencies in yak.pkg.
import lib.defaults
import labels = lib.labels
import {
  common = shared.common
  base
}

image: "\(defaults.image):\(defaults.tag)"
replicas: defaults.replicas
labels: labels.make("web")
team: common.team
region: base.region
defaults: defaults
