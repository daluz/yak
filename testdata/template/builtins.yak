## The standard library built-ins are called by their bare names.
ports: [80, 443, 8080]

sizes:
  ports: size($.ports)
  labels: size($$.selector)
  string: size("café")
  none: size([])
  named: size(value = "abcd")

## A hidden entry counts too: size describes the value rather than what
## the renderer writes out.
let defaults =
  image: "alpine"
  tag:: "3.20"
hidden-counted: size(defaults)

## Only null and the three empty collections are empty.
emptiness:
  absent: empty($$?.absent)
  mapping: empty($$.labels)
  sequence: empty([])
  string: empty("")
  zero: empty(0)
  flag: empty(false)
  ports: empty($.ports)

## nempty turns an empty value into null, which ":?" then drops.
service:
  labels:? nempty($$.labels)
  selector:? nempty($$.selector)
  region:? nempty($$?.region)

## A built-in is a value, so it can be passed to a function.
let apply(fn, to) = fn(to)
applied: apply(size, $.ports)

## A binding of the same name shadows a built-in.
shadowed:
  let size(v) = "not the built-in"
  value: size($.ports)
