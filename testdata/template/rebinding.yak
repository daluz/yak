## A name may be bound again in the block it is already bound in, which
## rebinds it from that line down. A reference written above every binding of
## a name reads the first one.
early: tag

let tag = "v1"
first: tag

## The rebinding's own value reads the binding it replaces.
let tag = "\(tag)-patched"
second: tag

## A nested block is read at the lines it is written on.
staging:
  image: "app:\(tag)"

let tag = "latest"

production:
  image: "app:\(tag)"
third: tag

## A rebound function may call the one it replaces.
let bump(n) = n + 1
let bump(n) = bump(n) * 2
bumped: bump(3)

## A comment travels from the binding that is actually read.
let {
  # The platform team owns this.
  owner = "platform"
}
before: owner

let {
  # Ownership moved to infra.
  owner = "infra"
}
after: owner
