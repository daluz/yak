import std.semver

releases: ["1.9.0", "v1.10.0", "1.2.3", "2.0.0-rc.1", "1.9.4", "0.9.0"]

isValid:
  plain: semver.isValid("1.2.3")
  prefixed: semver.isValid("v1.2.3")
  full: semver.isValid("1.2.3-rc.1+build.05")
  partial: semver.isValid("1.2")
  leadingZero: semver.isValid("1.02.3")
  leadingZeroPrerelease: semver.isValid("1.2.3-rc.01")
  emptyPrerelease: semver.isValid("1.2.3-")
  upperV: semver.isValid("V1.2.3")
parse:
  full: semver.parse("v1.2.3-rc.1+build.5")
  release: semver.parse("10.20.30")
compare:
  less: semver.compare("1.9.0", "1.10.0")
  equal: semver.compare("v1.2.3+a", "1.2.3+b")
  prerelease: semver.compare("1.0.0-rc.1", "1.0.0")
sort:
  releases: semver.sort($.releases)
  prereleases: semver.sort(["1.0.0", "1.0.0-rc.1", "1.0.0-beta.11", "1.0.0-beta.2", "1.0.0-beta", "1.0.0-alpha.beta", "1.0.0-alpha.1", "1.0.0-alpha"])
  stable: semver.sort(["1.0.0+b", "1.0.0+a", "0.1.0"])
  empty: semver.sort([])
min:
  all: semver.min($.releases)
  caret: semver.min($.releases, "^1.2")
  none: semver.min([], "*")
max:
  all: semver.max($.releases)
  caret: semver.max($.releases, "^1.2")
  tilde: semver.max($.releases, "~1.9")
  prerelease: semver.max($.releases, ">=2.0.0-rc.0")
  none: semver.max($.releases, ">=3")
bump:
  major: semver.bump("1.2.3", "major")
  minor: semver.bump("v1.2.3", "minor")
  patch: semver.bump("1.2.3+build", "patch")
  patchOfPrerelease: semver.bump("1.2.3-rc.1", "patch")
  minorOfPrerelease: semver.bump("1.3.0-rc.1", "minor")
  minorOfPatchPrerelease: semver.bump("1.2.3-rc.1", "minor")
satisfies:
  exact: semver.satisfies("1.2.3", "1.2.3")
  exactPrefixed: semver.satisfies("v1.2.3", "=v1.2.3")
  notEqual: semver.satisfies("1.2.3", "!=1.2.3")
  partial: semver.satisfies("1.2.9", "1.2")
  partialX: semver.satisfies("1.3.0", "1.2.x")
  any: semver.satisfies("5.0.0", "*")
  range: semver.satisfies("1.5.0", ">=1.0 <2.0")
  rangeComma: semver.satisfies("2.0.0", ">=1.0, <2.0")
  spacedOperator: semver.satisfies("1.5.0", ">= 1.0")
  greaterPartial: semver.satisfies("1.2.9", ">1.2")
  greaterPartialNext: semver.satisfies("1.3.0", ">1.2")
  atMostPartial: semver.satisfies("1.2.9", "<=1.2")
  tilde: semver.satisfies("1.2.9", "~1.2.3")
  tildeNext: semver.satisfies("1.3.0", "~1.2.3")
  tildeMajor: semver.satisfies("1.9.0", "~1")
  caret: semver.satisfies("1.9.0", "^1.2.3")
  caretNext: semver.satisfies("2.0.0", "^1.2.3")
  caretZero: semver.satisfies("0.3.0", "^0.2.3")
  caretZeroZero: semver.satisfies("0.0.4", "^0.0.3")
  caretZeroPartial: semver.satisfies("0.0.9", "^0.0")
  or: semver.satisfies("3.1.5", "^1.2 || ^3.1")
  prereleaseExcluded: semver.satisfies("2.0.0-alpha", ">=1.0.0")
  prereleaseBelowRelease: semver.satisfies("2.0.0-alpha", "<2.0.0")
  prereleaseNamed: semver.satisfies("2.0.0-rc.2", ">=2.0.0-rc.1")
  prereleaseOtherRelease: semver.satisfies("2.1.0-rc.1", ">=2.0.0-rc.1")
  prereleaseCaret: semver.satisfies("1.2.3-beta.4", "^1.2.3-beta.2")