import std.regex

image: "registry.example.com/team/web:1.4.2"

match:
  tagged: regex.match($.image, ":[0-9.]+$")
  anchored: regex.match($.image, "^web")
find:
  tag: regex.find($.image, r"\d+\.\d+\.\d+")
  none: regex.find($.image, "sha256:")
findAll:
  numbers: regex.findAll("a1b22c333", "[0-9]+")
  none: regex.findAll("abc", "[0-9]+")
replace:
  groups: regex.replace("web-01, api-02", "([a-z]+)-([0-9]+)", "$2-$1")
  named: regex.replace("v1.2", "v(?P<version>.*)", r"${version}")
  dollar: regex.replace("5", "[0-9]", "$$&")
