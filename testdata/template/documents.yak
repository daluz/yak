# Each document has its own root, and $context is shared by all of them.
kind: "ConfigMap"
name: "{$$.app}-config"
data:
  self-kind: ..kind
  note: |
    a block scalar may end right above the marker
---
kind: "Service"
name: "{$$.app}-svc"
selector:
  app: $.name
ports: [80, 443]
options: {debug: false, retries: 3}
...
