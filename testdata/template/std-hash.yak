import {
  std.hash
  std.yaml
}

config::
  level: "info"

sha1: hash.sha1("yak")
sha256: hash.sha256("yak")
sha512: hash.sha512("yak")
empty: hash.sha256("")

## A checksum of rendered configuration restarts pods when it changes.
annotations:
  "checksum/config": hash.sha256(yaml.encode($.config))
