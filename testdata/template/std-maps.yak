labels::
  app: "web"
  tier: "frontend"
  team: "platform"
  secret:: "hidden"

keys: keys($.labels)
values: values($.labels)
picked: pick($.labels, ["team", "app", "missing"])
omitted: omit($.labels, ["tier", "secret"])
empty: keys({})
shown: visible($.labels)
shownKeys: keys(visible($.labels))
kept: keys(visible({a: 1, b:? null, c:: 3}))
