## Bindings, defaults, and optional context lookups.
let name = $$.app.name
let {
  region = $$?.region ?? "us-east-1"
  zone = "\(region)a"
}
let labels =
  app: name
  region: region

service:
  name: "\(name)-web"
  labels: labels
  replicas: $$.app?.replicas ?? 1
  zone: zone
  # A binding may read the mapping it sits in, and may be declared after use.
  endpoint: url
  let url = "https://\(.name).\(.zone).example.com"
  tls: $$?.tls?.enabled ?? false

workers:
  - let role = "queue"
    name: "\(name)-\(role)"
    labels: labels
  - let role = "cron"
    name: "\(name)-\(role)"
    labels: labels

fallbacks:
  missing-mapping: $$?.absent?.deeper ?? "none"
  missing-index: $$.app.tags?[5] ?? "none"
  present-index: $$.app.tags?[0] ?? "none"
  explicit-null: $$.app.owner ?? "unassigned"
