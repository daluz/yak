# A comment above an entry is kept,
# including the rest of its paragraph.
service:
  # Comments nest with the entries they describe.
  name: "web"        # so do the ones written after a value
  replicas: 2

  ## A note for whoever edits this file, left out of the output.
  port: 8080

local {
  # A comment on a binding travels to wherever the binding is read.
  region = "us-east-1"
  zone = "{region}a"   # so does one written beside it
}

local defaults =
  # One written inside a binding's value travels with the value.
  tier: "shared"

## A note on a binding is left out, like a note written anywhere else.
local owner = "platform"

placement:
  # What the entry says itself comes first.
  region: region
  zone: zone

team: owner
defaults: defaults
copy: defaults         # a second reading brings the same comments along

workers:
  # The queue worker comes first.
  - name: "queue"    # each item keeps its own comments
  - name: "cron"

credentials::
  # Dropped along with the hidden entry it describes.
  user: "admin"

spare:: defaults       # a hidden entry carries nothing out either

### A banner is not the marker, so this comment is kept.
endpoint: "https://{$$.host}/"

# Whatever is left at the end comes out at the end.
---
# Every document keeps its own comments.
second: true
