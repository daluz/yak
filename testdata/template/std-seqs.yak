ports: [8080, 443, 80, 443]
names: ["web", "api", "db"]
services::
  - {name: "web", weight: 3}
  - {name: "api", weight: 1}
  - {name: "db", weight: 2}

sorted:
  numbers: sort($.ports)
  strings: sort($.names)
  byWeight: [s.name for s in sort($.services, (s) => s.weight)]
  named: [s.name for s in sort(key = (s) => -s.weight, values = $.services)]
  empty: sort([])
  nullKey: sort([3, 1, 2], null)
reversed: reverse($.names)
unique: unique($.ports)
flattened: flatten([[1, 2], [], [3]])
sliced:
  middle: slice($.names, 1, 2)
  rest: slice($.names, 1)
  last: slice($.names, -2)
  trimmed: slice($.names, 0, -1)
  past: slice($.names, -10, 10)
  crossed: slice($.names, 2, 1)
  named: slice(stop = 2, values = $.names, start = 0)
ranges:
  stop: range(3)
  counted: range(0, 3)
  offset: range(8080, 8083)
  stepped: range(0, 10, 3)
  down: range(5, 0, -2)
  named: range(1, step = 2, stop = 6)
  empty: range(3, 0)
  unreachable: range(0, 3, -1)
sums:
  integers: sum($.ports)
  mixed: sum([1, 0.5])
  empty: sum([])
extremes:
  min: min($.ports)
  max: max($.names)
  lightest: min($.services, (s) => s.weight).name
  heaviest: max($.services, (s) => s.weight).name
quantified:
  somePrivileged: some($.ports, (p) => p < 1024)
  everyPrivileged: every($.ports, (p) => p < 1024)
  someTrue: some([false, true])
  everyTrue: every([true, false])
  someOfNone: some([], (p) => true)
  everyOfNone: every([], (p) => false)
  ## Items after the one that decides are never evaluated.
  someStops: some([true, 1 / 0])
  everyStops: every([false, 1 / 0])
lazy:
  reversed: size(reverse([1, 1 / 0]))
  sliced: slice([1, 1 / 0], 0, 1)
  range: range(9223372036854775806, 9223372036854775807, 2)

## A named function works as a key as well as an anonymous one.
let negated(n) = -n
descending: sort($.ports, negated)
