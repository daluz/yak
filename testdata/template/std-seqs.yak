import std.seqs

ports: [8080, 443, 80, 443]
names: ["web", "api", "db"]
services::
  - {name: "web", weight: 3}
  - {name: "api", weight: 1}
  - {name: "db", weight: 2}

sorted:
  numbers: seqs.sort($.ports)
  strings: seqs.sort($.names)
  byWeight: [s.name for s in seqs.sort($.services, (s) => s.weight)]
  named: [s.name for s in seqs.sort(key = (s) => -s.weight, values = $.services)]
  empty: seqs.sort([])
  nullKey: seqs.sort([3, 1, 2], null)
reversed: seqs.reverse($.names)
unique: seqs.unique($.ports)
flattened: seqs.flatten([[1, 2], [], [3]])
taken:
  some: seqs.take($.names, 2)
  more: seqs.take($.names, 10)
dropped:
  some: seqs.drop($.names, 1)
  more: seqs.drop($.names, 10)
ranges:
  stop: seqs.range(3)
  counted: seqs.range(0, 3)
  offset: seqs.range(8080, 8083)
  stepped: seqs.range(0, 10, 3)
  down: seqs.range(5, 0, -2)
  named: seqs.range(1, step = 2, stop = 6)
  empty: seqs.range(3, 0)
  unreachable: seqs.range(0, 3, -1)
sums:
  integers: seqs.sum($.ports)
  mixed: seqs.sum([1, 0.5])
  empty: seqs.sum([])
extremes:
  min: seqs.min($.ports)
  max: seqs.max($.names)
  lightest: seqs.min($.services, (s) => s.weight).name
  heaviest: seqs.max($.services, (s) => s.weight).name
quantified:
  anyPrivileged: seqs.any($.ports, (p) => p < 1024)
  allPrivileged: seqs.all($.ports, (p) => p < 1024)
  anyTrue: seqs.any([false, true])
  allTrue: seqs.all([true, false])
  anyOfNone: seqs.any([], (p) => true)
  allOfNone: seqs.all([], (p) => false)

## Every name of the module imports the same functions.
import std.sequences
import std.lists
aliases: [sequences.reverse([1, 2]), lists.reverse([1, 2])]

## A named function works as a key as well as an anonymous one.
local negated(n) = -n
descending: seqs.sort($.ports, negated)
