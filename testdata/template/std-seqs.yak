ports: [8080, 443, 80, 443]
names: ["web", "api", "db"]
services::
  - {name: "web", weight: 3}
  - {name: "api", weight: 1}
  - {name: "db", weight: 2}

sorted:
  numbers: sort($.ports)
  strings: sort($.names)
  byWeight: [s.name for s in sort($.services, (s) => s.weight)]
  named: [s.name for s in sort(key = (s) => -s.weight, values = $.services)]
  empty: sort([])
  nullKey: sort([3, 1, 2], null)
reversed: reverse($.names)
unique: unique($.ports)
flattened: flatten([[1, 2], [], [3]])
taken:
  some: take($.names, 2)
  more: take($.names, 10)
dropped:
  some: drop($.names, 1)
  more: drop($.names, 10)
ranges:
  stop: range(3)
  counted: range(0, 3)
  offset: range(8080, 8083)
  stepped: range(0, 10, 3)
  down: range(5, 0, -2)
  named: range(1, step = 2, stop = 6)
  empty: range(3, 0)
  unreachable: range(0, 3, -1)
sums:
  integers: sum($.ports)
  mixed: sum([1, 0.5])
  empty: sum([])
extremes:
  min: min($.ports)
  max: max($.names)
  lightest: min($.services, (s) => s.weight).name
  heaviest: max($.services, (s) => s.weight).name
quantified:
  anyPrivileged: any($.ports, (p) => p < 1024)
  allPrivileged: all($.ports, (p) => p < 1024)
  anyTrue: any([false, true])
  allTrue: all([true, false])
  anyOfNone: any([], (p) => true)
  allOfNone: all([], (p) => false)

## A named function works as a key as well as an anonymous one.
let negated(n) = -n
descending: sort($.ports, negated)
