## Every built-in type has a short name, and "seq[T]" is "sequence[T]".
schema Config =
  enabled: bool
  replicas: int
  ratio: float
  name: str
  ports: seq[int]
  hosts: sequence[str]
  tags: seq
  labels: map
  matrix: seq[seq[int | float]]

schema Fn = func

let double = !Fn (x) => x * 2

config: !Config
  enabled: true
  replicas: double(2)
  ratio: 0.5
  name: "web"
  ports: [80, 443]
  hosts: ["a.example.com"]
  tags: ["edge", 1]
  labels: {tier: "front"}
  matrix: [[1, 2.5], []]
