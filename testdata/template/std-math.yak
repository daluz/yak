import std.math

abs:
  integer: math.abs(-3)
  float: math.abs(-2.5)
floor:
  positive: math.floor(2.7)
  negative: math.floor(-2.2)
  integer: math.floor(4)
ceil:
  positive: math.ceil(2.1)
  negative: math.ceil(-2.7)
round:
  down: math.round(2.4)
  half: math.round(2.5)
  negativeHalf: math.round(-2.5)
  digits: math.round(3.14159, 2)
  integerDigits: math.round(7, 2)

## Rounding answers an integer, so it can count replicas.
replicas: math.ceil(5 / 2)
