---
{
  # Every string form, with and without interpolation.
  who: "world",
  double: "hello",
  single: "hello",
  escapes: "tab:\tquote:\"backslash:\\",
  unicode: "café",
  interpolated: "hello world",
  mixed: "world and world",
  raw-double: "no ${interpolation} here",
  raw-single: "no ${interpolation} here",
  escaped-dollar: "a literal ${braces} pair",
  lone-dollar: "costs $5",
  nested-quotes: "zone is us-east-1",
  folded-quotes: "one two",
  literal-block: "\
     first line\n\
     second line for world\n\
    ",
  literal-strip: "no trailing newline",
  literal-keep: "\
     kept blank line below\n\
     \n\
    ",
  folded-block: "\
     these lines become one\n\
     this is a second paragraph\n\
    ",
  folded-strip: "folded without a trailing newline",
  raw-block: "\
     ${untouched}\n\
    ",
  indented-block: "\
     outer\n\
    \  inner indented\n\
    ",
}
